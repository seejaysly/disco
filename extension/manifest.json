{
  "manifest_version": 3,
  "name": "Disco (new)",
  "short_name": "Disco",
  "description": "Highlight anything on the web, right-click, and save it to Disco.",
  "version": "2.2.1",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Disco",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Save the highlighted text to Disco"
    }
  },
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "identity",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://rlvwfzhvbyuwtbnrqkou.supabase.co/*",
    "https://sheets.googleapis.com/*"
  ]
}
